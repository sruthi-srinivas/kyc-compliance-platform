# Application Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL primary; supports SQLite fallback for local zero-dependency testing)
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/kyc_compliance
DATABASE_URL=sqlite:///./kyc_compliance.db

# Synthetic Data Generation Seed (Mandatory fixed seed)
RANDOM_SEED=20261022

# Dataset Volume Presets: 'starter' (200 customers) or 'full' (8,000 customers)
DATASET_PRESET=starter

# Paths
DATA_DIR=data
GENERATED_DIR=data/generated
GROUND_TRUTH_DIR=data/ground_truth
STARTER_DIR=data/starter

# Logging
LOG_LEVEL=INFO
